# Copy to .env and adjust for local dev. Never commit the real .env.
# Read by docker-compose.yml only — each service still has its own
# .env.example for running it standalone (outside Docker).
AUTH_JWT_SECRET_KEY=change-me-to-a-long-random-value

# Test-mode Stripe keys for orders-service (checkout). Free account, no
# business verification needed for test mode: dashboard.stripe.com/register
# then dashboard.stripe.com/test/apikeys. Leave blank to run everything
# except actually paying — checkout fails at the Stripe step with a clear
# 502 until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
