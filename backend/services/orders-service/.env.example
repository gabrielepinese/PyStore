# Copy to .env and adjust for local dev. Never commit the real .env.
DATABASE_URL=sqlite:///./orders.db
# Must match auth-service's JWT_SECRET_KEY — this service only verifies
# tokens auth-service issued, it never mints its own.
JWT_SECRET_KEY=change-me-to-a-long-random-value
PRODUCTS_SERVICE_URL=http://localhost:8002/api/v1
# Test-mode Stripe keys only (sk_test_... / whsec_...). Create a free
# account at https://dashboard.stripe.com/register — no business
# verification is needed to use test mode, only to accept real payments.
# Get the secret key at https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=
# Only needed for the optional /webhooks/stripe endpoint (see README).
STRIPE_WEBHOOK_SECRET=
CORS_ORIGINS=["http://localhost:4200"]
